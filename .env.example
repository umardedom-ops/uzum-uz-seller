# ==== Telegram ====
BOT_TOKEN=123456:REPLACE_ME
ADMIN_IDS=111111111,222222222      # vergul bilan ajratilgan telegram_id lar

# ==== Ma'lumotlar bazasi ====
# Lokal dev (Dockersiz, tez boshlash):
DATABASE_URL=sqlite+aiosqlite:///./uzumbot.db
# Production: docker-compose DATABASE_URL ni O'ZI qo'yadi, bu yerga
# yozish shart emas. Faqat parolni bering:
POSTGRES_PASSWORD=
# POSTGRES_USER=uzumbot
# POSTGRES_DB=uzumbot
# WEB_PORT=8000

# ==== Shifrlash ====
# Fernet kalit. Generatsiya: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=REPLACE_WITH_GENERATED_KEY

# ==== Uzum ====
UZUM_API_BASE=https://api-seller.uzum.uz
UZUM_RATE_LIMIT_PER_SEC=1          # bitta do'konga soniyada 1 so'rov

# ==== Onboarding ====
# Seller kabinetida "Xodim" sifatida qo'shiladigan BIZNING raqamimiz
EMPLOYEE_PHONE=+998 90 123 45 67
EMPLOYEE_NAME=Seller yordamchisi
EMPLOYEE_ROLE=Финансовый менеджер
OFERTA_URL=https://example.com/oferta
SUPPORT_USERNAME=@support

# ==== Tariflar va to'lov ====
TRIAL_DAYS=3
PRICE_BASIC=149000
PRICE_PRO=299000

# --- Click (merchant.click.uz → Servislar) ---
# Bularsiz to'lov QO'LDA tasdiqlanadi (admin tugma bosadi)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
# Webhook serveri manzili — Click kabinetiga shu asosda yoziladi:
#   <CLICK_BASE_URL>/click/prepare
#   <CLICK_BASE_URL>/click/complete
CLICK_BASE_URL=https://sizning-domeningiz.uz

# --- Telegram Payments (muqobil yo'l) ---
# @BotFather → /mybots → Payments
PAYMENT_PROVIDER_TOKEN=
PAYMENT_CURRENCY=UZS
# Qo'lda to'lov uchun ko'rsatma matni
PAYMENT_DETAILS=

# ==== Umumiy ====
ENV=dev                            # dev | prod
LOG_LEVEL=INFO
TZ=Asia/Tashkent
